# Pulled datasets are huge (multi-GB video/parquet) — never commit the raw data.
# The lightweight collection history (每日新增 / 趋势) lives in the git-committed
# root file ./dataset_log.json instead, so a clone gets history without datasets/.
datasets/
pulls/
# Legacy migration input; dataset_log.json is now the authoritative history.
pull_history.local.json
# HF commit diffs are a rebuildable local cache layered over dataset_log.json.
hf_change_history.local.json
quality_status.local.json
.quality_cache/
.quality_reports/
**/quality_clips/

# Python virtual env / caches
.venv/
__pycache__/
*.py[cod]

# Node / Next.js dependencies and caches
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Runtime logs
*.log

# Local Claude/editor settings
.claude/
.vscode/
.idea/

# HF cache (if ever created here)
.cache/
vendor/

# Locally-saved HF token from the 切换账号 dialog — never commit / share.
.hf_token
